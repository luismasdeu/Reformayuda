rules_version = '2';
// Reglas de Firestore de Obrayuda: notificaciones y medición anónima.
// Cada móvil solo puede crear, cambiar o borrar su propia suscripción (el id es un resumen de su token).
// Nadie puede leerlas desde fuera: solo el proceso de envío de GitHub, con la cuenta de servicio.
service cloud.firestore {
  match /databases/{database}/documents {
    match /suscripciones/{id} {
      allow read: if false;
      allow delete: if id.size() == 64;
      allow create, update: if id.size() == 64
        && request.resource.data.keys().hasOnly(['token', 'ccaa', 'prov', 'tipos', 'guardadas', 'nuevas', 'plazos', 'actualizado'])
        && request.resource.data.token is string && request.resource.data.token.size() < 400
        && request.resource.data.ccaa is string && request.resource.data.ccaa.size() < 40
        && request.resource.data.prov is string && request.resource.data.prov.size() < 40
        && request.resource.data.tipos is list && request.resource.data.tipos.size() <= 7
        && request.resource.data.guardadas is list && request.resource.data.guardadas.size() <= 100
        && request.resource.data.nuevas is bool
        && request.resource.data.plazos is bool;
    }
    // Medición anónima (solo si la persona la acepta): contadores por día que solo pueden subir de 1 en 1.
    // No se guarda nada de quien visita. Nadie puede leerlos desde fuera.
    match /visitas/{dia} {
      function sube(k) {
        return !(k in request.resource.data.diff(resource.data).affectedKeys())
          || request.resource.data[k] == resource.data.get(k, 0) + 1;
      }
      allow read, delete: if false;
      allow create: if dia.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && request.resource.data.keys().hasOnly(['visitas', 'nuevos', 'app', 'busquedas', 'fichas', 'sede', 'chat'])
        && request.resource.data.size() == 1
        && request.resource.data.values()[0] == 1;
      allow update: if request.resource.data.keys().hasOnly(['visitas', 'nuevos', 'app', 'busquedas', 'fichas', 'sede', 'chat'])
        && request.resource.data.diff(resource.data).affectedKeys().size() == 1
        && sube('visitas') && sube('nuevos') && sube('app') && sube('busquedas') && sube('fichas') && sube('sede') && sube('chat');
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
